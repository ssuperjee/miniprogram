<!--pages/login/index.wxml-->
<view class="login-page">
  <navigation-bar title="" back="{{false}}" mode="overlay" placeholder="{{true}}" color="black" background="transparent"></navigation-bar>

  <view class="login-page__logo">
    <image class="login-page__logo-icon" src="/assets/image/manager/2.png" mode="widthFix" />
  </view>

  <view class="login-page__title">侵权线索管理系统</view>
  <view class="login-page__subtitle">先锋品牌保护</view>

  <view class="login-form">
    <view class="login-form__field-label">
      <text class="login-form__required-label">手机号</text>
    </view>

    <view class="login-form__input-group">
      <image class="login-form__input-icon" src="/assets/image/manager/2.png" mode="widthFix" />
      <input class="login-form__input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="login-form__tips">仅支持预注册手机号登录</view>

    <view class="login-form__field-label">
      <text class="login-form__required-label">验证码</text>
    </view>

    <view class="login-form__verify-row">
      <view class="login-form__verify-input-group">
        <image class="login-form__input-icon" src="/assets/image/manager/2.png" mode="widthFix" />
        <input class="login-form__input" type="number" maxlength="6" placeholder="请输入6位验证码" value="{{code}}" bindinput="onCodeInput" />
      </view>
      <button class="login-form__verify-button login-form__verify-button--{{verifyButtonState}} font26" disabled="{{verifyButtonState !== 'active'}}" bindtap="onGetCode">{{verifyButtonText}}</button>
    </view>

    <button class="login-form__submit login-form__submit--{{loginButtonState}} font30" disabled="{{loginButtonState !== 'active'}}">登录</button>
  </view>

  <view class="login-page__footer">
    <view class="font26rpx">© 2026 产品种植侵权线索管理系统</view>
    <view class="font22">版本 v1.0.0</view>
  </view>

</view>